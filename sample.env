# Required Telegram bot credentials
TOKEN=1234567890:replace_with_your_bot_token
API_ID=12345678
API_HASH=replace_with_your_api_hash

# Required MongoDB database URLs
DB_URL=mongodb+srv://user:password@cluster.example.mongodb.net/AxiomX?retryWrites=true&w=majority
DB_URL2=mongodb+srv://user:password@cluster.example.mongodb.net/AxiomX2?retryWrites=true&w=majority

# Optional Telegram/userbot and logging settings
USER_STRING=
BOT_USERNAME=@your_bot_username
BOT_NAME=AxiomX
OWNER_ID=123456789
AXIOM_OWNER_ID=123456789
SUDO_USERS=123456789 987654321
SUPPORT_USERS=
WHITELIST_USERS=
DEV_LIST=123456789
LOG_GROUP_ID=-1001234567890
LOGS_CHANNEL=-1001234567890
SUPPORT_CHAT=your_support_group_username
SUPPORT_GROUP=https://t.me/your_support_group
UPDATE_CHANNEL=your_update_channel_username

# Web/deploy settings. Railway/Heroku inject PORT automatically.
IS_WEB_SUP=True
WEB_SERVER_BIND_ADDRESS=0.0.0.0
WEB_URL=
WEB_SLEEP=240
MULTI_CLIENT=False
PREFIX=True

# Optional feature API keys
ELEVENLABS_API_KEY=
IMAGE_UPLOAD_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MONSTER_API_KEY=
REPLICATE_API_TOKEN=
GIST_TOKEN=
TELEGRAPH_TOKEN=
